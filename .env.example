# KliK 2026 PWA Environment Configuration

# Mapbox GL Token (Optional for development)
# If left blank, the application automatically activates the accessible,
# interactive venue-list and external directions fallback without breaking.
# Obtain from: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase Configuration (Optional for development)
# If left blank, the application runs fully functional using local seed data
# and IndexedDB device-side persistence.
# Obtain from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Application URL (Used for QR check-in deep-links and social share)
NEXT_PUBLIC_APP_URL=http://localhost:3000
